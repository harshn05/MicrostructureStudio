# 1. Root definition (Aapka existing rule)
root = true

# 2. Global settings (Aapke baseline rules, bas safe cross-platform toolchain ke liye end_of_line=lf kiya hai)
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# 3. C++, Python, aur Cython ke liye strictly 4 spaces
[*.{cpp,h,hpp,cc,cxx,c,hxx,py,pyx,pxd}]
indent_size = 4

# 4. CMake build system (nested conditionals ke liye light weight 2 spaces)
[CMakeLists.txt, *.cmake]
indent_style = space
indent_size = 2

# 5. Data formats, Configs aur Markup (Aapka existing rule + safe adjustments)
[*.{json,yaml,yml,md,xml}]
indent_style = space
indent_size = 2

# 6. Crucial for MSYS2/MinGW: Makefiles must use real TABS, spaces completely break them
[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

# 7. Windows Command Script (Aapka existing rule - native CMD compatibility ke liye CRLF)
[*.bat]
end_of_line = crlf
